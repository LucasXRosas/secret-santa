{
  "name": "secret-santa",
  "version": "0.0.0",
  "scripts": {
    "dev:web": "npm run start -w apps/web",
    "dev:api": "echo 'Backend não configurado. Rode o Workflow 2.'",
    "format": "prettier --write \"**/*.{ts,js,json,css,html,md}\"",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
