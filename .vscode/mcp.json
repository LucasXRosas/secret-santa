{
  // For more information, visit: https://angular.dev/ai/mcp
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${input:stitchApiKey}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "stitchApiKey",
      "description": "Stitch (Google) API Key",
      "password": true
    }
  ]
}
